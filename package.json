{
  "name": "budgeting-financial-tool",
  "version": "1.0.0",
  "description": "A minimalistic financial budgeting application",
  "private": true,
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -k -n api,web \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/server.js",
    "build": "tsc -b && vite build",
    "start": "node server/server.js",
    "preview": "vite preview",
    "check:lines": "node scripts/check-file-lines.mjs",
    "deploy": "node scripts/deploy.mjs --build",
    "deploy:reset": "node scripts/deploy.mjs --build --reset"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.4.7",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.4.3",
    "helmet": "^8.1.0",
    "lucide-react": "^0.563.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^11.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "concurrently": "^8.2.2",
    "ssh2": "^1.16.0",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
